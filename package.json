{
  "name": "AIoT-Backend",
  "version": "1.68.2",
  "description": "NestJS, Typescript, Postgres, TypeORM",
  "author": "Pham Van Khang <phamvankhang.tvi@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "resolutions": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build:prod": "nest build",
    "start:dev": "vite",
    "nest:start": "nest start ./src/main.ts",
    "nest:start:dev": "nest start --watch",
    "nest:start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:dev:bun": "bun run ./src/main.ts",
    "watch:bun": "bun run --watch ./src/main.ts",
    "build:bun": "bun build --external=class-validator --external=@nestjs/sequelize --external=@mikro-orm/core --external=@nestjs/mongoose --external=mock-aws-s3 --external=hbs --external=aws-sdk --external=nock --external=@nestjs/websockets/socket-module --external=class-transformer --external=@nestjs/microservices --define process.env.NODE_ENV:\"'production'\" --target=bun --minify ./dist/main.js --outdir=dist --format esm ./src/main.ts",
    "build:web": "cd web && pnpm build",
    "docker:build-push": "bash scripts/docker-build-push.sh",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "sh -c 'npm run typeorm migration:generate -d ormconfig.ts ./src/database/migrations/$0'",
    "migration:create": "sh -c 'npm run typeorm migration:create ./src/database/migrations/$0'",
    "generate": "nest g -c awesome-nestjs-schematics --no-spec --flat",
    "g": "npm generate",
    "migration:run": "npm run typeorm migration:run -d ormconfig.ts",
    "migration:revert": "npm run typeorm migration:revert -d ormconfig.ts",
    "schema:drop": "npm run typeorm schema:drop -d ormconfig.ts",
    "watch:dev": "nest start --watch ./src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "docs:dev": "vuepress dev -p 7070",
    "docs:build": "DEPLOY_ENV=gh-pages vuepress build",
    "docs:deploy": "npm run docs:build && gh-pages -d .vuepress/dist",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.741.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/cqrs": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.2.1",
    "@vkhang2stack/snowflake-id": "^1.0.2",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.14.1",
    "compression": "^1.7.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.11.19",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.0",
    "morgan": "^1.10.0",
    "mqtt": "^5.15.2",
    "nestjs-cls": "^5.0.1",
    "nestjs-i18n": "^10.5.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "parse-duration": "^2.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "source-map-support": "^0.5.21",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "typeorm": "0.3.20",
    "typeorm-transactional": "~0.5.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.0.7",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.12",
    "@swc/jest": "^0.2.39",
    "@swc/plugin-transform-imports": "^13.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cache-manager-redis-store": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/lodash": "^4.17.15",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vuepress/bundler-vite": "2.0.0-rc.19",
    "@vuepress/theme-default": "2.0.0-rc.68",
    "awesome-nestjs-schematics": "^10.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "release-it": "^18.1.2",
    "sass-embedded": "^1.83.4",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.11",
    "vite-plugin-node": "^4.0.0",
    "vue": "^3.5.13",
    "vuepress": "2.0.0-rc.19"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transformIgnorePatterns": [
      "/node_modules/(?!.*parse-duration)"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "sourceMaps": true,
          "module": {
            "type": "commonjs"
          },
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "esnext",
            "keepClassNames": true
          },
          "swcrc": false
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.ts$": "$1"
    }
  }
}
